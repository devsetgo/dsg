# Copy to .env in the repo root (or pass as env vars). Every value shown is the default.

# database: sqlite (a file in DB_DIRECTORY) or memory (tests only - see src/settings.py)
DB_DRIVER=sqlite
DB_DIRECTORY=sqlite_db
DB_NAME=dsg
ECHO=False
FUTURE=True
POOL_RECYCLE=3600
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_CACHE_SIZE_KIB=65536
SQLITE_MMAP_SIZE_BYTES=268435456

# server (python -m src.main --processes N --workers M)
HOST=0.0.0.0
PORT=5000
DEBUG_MODE=False

# logging
LOGGING_DIRECTORY=log
LOG_NAME=log
LOGGING_LEVEL=INFO
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_BACKTRACE=False
LOG_SERIALIZER=False
LOG_DIAGNOSE=False
LOG_INTERCEPT_STANDARD_LOGGING=False
ACCESS_LOG=False

# resolver
PYPI_SIMPLE_URL=https://pypi.org/simple
PYPI_JSON_URL=https://pypi.org/pypi
PYPI_TIMEOUT_SECONDS=30
PYPI_MAX_CONNECTIONS=32
INDEX_CACHE_TTL_SECONDS=3600
VERSION_INFO_CACHE_TTL_SECONDS=86400
CHECK_TIMEOUT_SECONDS=180
# per process: resolutions at once, and how many more may wait before HTTP 429
MAX_CONCURRENT_CHECKS=4
MAX_QUEUED_CHECKS=20
# per client IP per process for POST /check and /api/check; 0 disables
CHECKS_PER_MINUTE_PER_IP=10
# reverse proxies in front of the app (Traefik = 1); the client IP is read that far from the right of X-Forwarded-For; 0 ignores the header
FORWARDED_PROXY_HOPS=1
# list every check on /history; off = results are reachable only by their link
PUBLIC_HISTORY=False
RESOLVER_MAX_ROUNDS=2000
MAX_REQUIREMENT_LINES=100
DEFAULT_PYTHON_VERSION=3.14

# health endpoints
HEALTH_STATUS_ENDPOINT=True
HEALTH_UPTIME_ENDPOINT=True
